# 第一课不会自动读取 .env；真实调用前请在终端显式设置以下变量。
MODEL_API_KEY=
MODEL_NAME=
# 可选：OpenAI 兼容接口地址，通常包含 /v1。
MODEL_BASE_URL=

# 第二课 PostgreSQL 配置；不会自动加载此文件，按讲义在终端设置。
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PGDATABASE=personal_superagent
PGUSER=personal_superagent
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
